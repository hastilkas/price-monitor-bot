# Токен от @BotFather
BOT_TOKEN=123456789:AA...

# Telegram ID администраторов через запятую — им доступна команда /stats.
# Свой ID можно узнать у @userinfobot
ADMIN_IDS=

# Как часто проверять цены, минут (не меньше 5: частые запросы — быстрый бан IP на площадках)
CHECK_INTERVAL_MINUTES=30
# Сколько товаров может отслеживать один пользователь
MAX_PRODUCTS_PER_USER=30

# Прокси для всех запросов к площадкам: http://user:pass@host:port или socks5://host:port.
# Нужен, если бот запущен на зарубежном сервере — маркетплейсы пускают в основном российские IP
PROXY_URL=

# Браузер для прохождения антибот-проверок.
# chrome — установленный Google Chrome (рекомендуется: с ним проверку проходит и WB, и Ozon)
# chromium — встроенный Chromium из patchright (без Chrome WB и Ozon обычно не пускают)
BROWSER_CHANNEL=chrome
# false — запускать браузер с окном (на сервере — через виртуальный дисплей Xvfb, см. Dockerfile)
BROWSER_HEADLESS=true

# Регион доставки Wildberries — от него зависят цены и наличие. -1257786 — Москва
WB_DEST=-1257786

DATABASE=data/prices.db
TIMEZONE=Europe/Moscow

# Демо-режим для портфолио: в карточке появляется кнопка «Пример уведомления»
DEMO_MODE=false
